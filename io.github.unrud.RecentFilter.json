{
    "app-id": "io.github.unrud.RecentFilter",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "recent-filter",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-data",
        "--filesystem=home:ro"
    ],
    "modules": [
        {
            "name": "recent-filter",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "path": "."
                }
            ]
        }
    ]
}
